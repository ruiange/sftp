{
  "defaultProfile": "development",
  "uploadOnSave": false,
  "ignore": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.DS_Store",
    "**/.vscode/sftp-sync.json"
  ],
  "profiles": {
    "development": {
      "protocol": "sftp",
      "host": "example.com",
      "port": 22,
      "username": "deploy",
      "privateKeyPath": "~/.ssh/id_rsa",
      "remotePath": "/var/www/${workspaceFolderBasename}",
      "uploadOnSave": false
    },
    "ftpExample": {
      "protocol": "ftp",
      "host": "ftp.example.com",
      "port": 21,
      "username": "ftp-user",
      "password": "${env:FTP_PASSWORD}",
      "remotePath": "/public_html",
      "secure": false
    }
  }
}
